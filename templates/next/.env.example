# ── Standalone mode (default) ───────────────────────────────────────────────
DATABASE_URL=postgresql://evoapp:evoapp@localhost:5446/evoapp
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:4180

# Local SMTP (optional in standalone; sending is a logged no-op without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Platform mode (uncomment to delegate auth/tenancy/email to EvoPlatform) ─
# PLATFORM_URL=http://localhost:8200
# EVO_CLIENT_ID=
# EVO_CLIENT_SECRET=
# PLATFORM_DEFAULT_WORKSPACE=
# NEXT_PUBLIC_PLATFORM_MODE=1
