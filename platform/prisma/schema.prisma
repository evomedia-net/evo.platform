generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PAST_DUE
}

model Tenant {
  id                   String       @id @default(uuid())
  slug                 String       @unique
  name                 String
  plan                 String       @default("free")
  status               TenantStatus @default(ACTIVE)
  // Company profile — a tenant is an organization, so it carries the address.
  phone                String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  country              String?
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?
  // While PAST_DUE, logins keep working until this moment (billing grace).
  graceUntil           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  users                User[]
  smtpConfig           SmtpConfig?
  appTenants           AppTenant[]
  invites              Invite[]

  @@map("tenants")
}

// A pending membership: the mailbox owner proves control by following the
// emailed link and choosing their own password. Only the sha256 of the token
// is stored — the raw value exists solely inside the email.
model Invite {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  // Roles to grant on accept; re-validated against enabled apps at that moment.
  roleIds       String[]
  isTenantAdmin Boolean   @default(false)
  invitedById   String?
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@map("invites")
}

model User {
  id              String    @id @default(uuid())
  tenantId        String?   // null = platform-level user (global admin)
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  email           String
  passwordHash    String
  // Display name, kept in sync from firstName/lastName; it's what the JWT
  // `name` claim and apps read. Set directly only via the legacy API path.
  name            String?
  firstName       String?
  lastName        String?
  phone           String?
  isPlatformAdmin Boolean   @default(false)
  // Tenant admin: may manage their own tenant's members via /tenant/*.
  isTenantAdmin   Boolean   @default(false)
  // NULL = mailbox not yet proven; login is refused until it is. Admin-created
  // users are stamped at creation (credentials were handed over directly).
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  roles           UserRole[]
  refreshTokens   RefreshToken[]
  passkeys        PasskeyCredential[]

  @@unique([tenantId, email])
  @@map("users")
}

model PasskeyCredential {
  id           String    @id @default(uuid())
  tenantId     String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Globally unique per the WebAuthn spec (authenticator-generated random id);
  // it's the lookup key at login time, before identity is otherwise known.
  credentialId String    @unique
  publicKey    Bytes
  signCount    Int       @default(0)
  transports   String? // csv, browser-reported metadata (informational only)
  aaguid       String?
  nickname     String    @default("Passkey")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkey_credentials")
}

model App {
  id               String   @id @default(uuid())
  clientId         String   @unique
  clientSecretHash String
  name             String   @unique
  callbackUrls     String[]
  // Stripe Price (price_...) for this app's subscription; null = not sellable yet.
  stripePriceId    String?
  // false = admin-created tenants are NOT auto-enabled on this app; access
  // must be granted specifically (console, signup-through, or subscription).
  autoEnroll       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  roles            Role[]
  appTenants       AppTenant[]

  @@map("apps")
}

enum AppTenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

// Which tenants may sign in to which apps, and on what terms. No row = the
// app is not enabled for that tenant and logins scoped to it are refused.
model AppTenant {
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appId       String
  app         App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  status      AppTenantStatus @default(ACTIVE)
  plan        String          @default("free")
  // TRIAL logins keep working until this moment.
  trialEndsAt DateTime?
  // While PAST_DUE, logins for this app keep working until this moment.
  graceUntil  DateTime?
  // The Stripe subscription that owns this row's status (one sub per app+tenant).
  stripeSubscriptionId String? @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@id([tenantId, appId])
  @@map("app_tenants")
}

model Role {
  id          String     @id @default(uuid())
  appId       String
  app         App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  name        String
  description String?
  users       UserRole[]

  @@unique([appId, name])
  @@map("roles")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  appClientId String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model SmtpConfig {
  id          String  @id @default(uuid())
  tenantId    String? @unique // null = platform default config
  tenant      Tenant? @relation(fields: [tenantId], references: [id])
  host        String
  port        Int
  secure      Boolean @default(false)
  username    String?
  passwordEnc String? // AES-256-GCM encrypted with SECRET_KEY
  fromAddress String

  @@map("smtp_configs")
}

model AuditEvent {
  id          String   @id @default(uuid())
  tenantId    String?
  userId      String?
  appClientId String?
  action      String
  detail      Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}
