generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma.config.ts (Prisma 7 requires this, not the schema).
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PAST_DUE
}

model Tenant {
  id                   String       @id @default(uuid())
  slug                 String       @unique
  name                 String
  plan                 String       @default("free")
  status               TenantStatus @default(ACTIVE)
  // Company profile — a tenant is an organization, so it carries the address.
  phone                String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  country              String?
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?
  // While PAST_DUE, logins keep working until this moment (billing grace).
  graceUntil           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  users                User[]
  smtpConfig           SmtpConfig?
  appTenants           AppTenant[]
  invites              Invite[]

  @@map("tenants")
}

// A pending membership: the mailbox owner proves control by following the
// emailed link and choosing their own password. Only the sha256 of the token
// is stored — the raw value exists solely inside the email.
model Invite {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  // Roles to grant on accept; re-validated against enabled apps at that moment.
  roleIds       String[]
  isTenantAdmin Boolean   @default(false)
  invitedById   String?
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@map("invites")
}

/// Email is unique per tenant. Platform-level users (tenantId null) are NOT
/// covered by that constraint — Postgres treats NULLs as distinct — so a
/// partial unique index `users_platform_email_key` on (email) WHERE tenantId
/// IS NULL is declared in migration 20260731120000_platform_user_email_unique.
/// Prisma cannot express partial indexes here; do not drop it if a future
/// `prisma migrate dev` offers to.
model User {
  id              String    @id @default(uuid())
  tenantId        String?   // null = platform-level user (global admin)
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  email           String
  passwordHash    String
  // Display name, kept in sync from firstName/lastName; it's what the JWT
  // `name` claim and apps read. Set directly only via the legacy API path.
  name            String?
  firstName       String?
  lastName        String?
  phone           String?
  isPlatformAdmin Boolean   @default(false)
  // Tenant admin: may manage their own tenant's members via /tenant/*.
  isTenantAdmin   Boolean   @default(false)
  // NULL = mailbox not yet proven; login is refused until it is. Admin-created
  // users are stamped at creation (credentials were handed over directly).
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  roles           UserRole[]
  refreshTokens   RefreshToken[]
  passkeys        PasskeyCredential[]

  @@unique([tenantId, email])
  @@map("users")
}

model PasskeyCredential {
  id           String    @id @default(uuid())
  tenantId     String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Globally unique per the WebAuthn spec (authenticator-generated random id);
  // it's the lookup key at login time, before identity is otherwise known.
  credentialId String    @unique
  publicKey    Bytes
  signCount    Int       @default(0)
  transports   String? // csv, browser-reported metadata (informational only)
  aaguid       String?
  nickname     String    @default("Passkey")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkey_credentials")
}

model App {
  id               String   @id @default(uuid())
  clientId         String   @unique
  clientSecretHash String
  name             String   @unique
  /// What a customer should read: "SWAG Estimates", not the "swag-estimates"
  /// registry slug. Used in email subjects, sender names and the recovery
  /// pages, where showing a slug undermines the legitimacy the message needs
  /// (#103). Null falls back to a titleized name.
  displayName      String?
  callbackUrls     String[]
  // false = admin-created tenants are NOT auto-enabled on this app; access
  // must be granted specifically (console, signup-through, or subscription).
  autoEnroll       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Soft delete, matching Tenant and User. Keeps clientId and name
  // reserved while deleted, so a re-registration cannot silently inherit
  // an old app's tenant grants.
  deletedAt        DateTime?
  roles            Role[]
  appTenants       AppTenant[]
  /// Brand identity served to this app: product name, wordmark halves,
  /// domains, support addresses, legal entity. The schema matches the
  /// brand.json each app ships as its offline fallback (#91), so the same
  /// shape works whether it came from here or from disk.
  ///
  /// Json rather than columns because the record is nested and grows by
  /// field, not by row - a typed column per key would mean a migration every
  /// time a brand gains one. Null means "not configured", which is a genuine
  /// absence, not a kind: an app with no row falls back to its own file.
  brand            Json?
  // What this app sells. No row = not sellable yet.
  prices           AppPrice[]

  @@map("apps")
}

// One sellable price. Rows, never columns: an app may sell two tiers or
// twenty-five, monthly and annual or anything else Stripe supports, without a
// schema change.
model AppPrice {
  id            String   @id @default(uuid())
  appId         String
  app           App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  // Globally unique so a webhook can resolve a subscription's price to exactly
  // one (app, tier) - and so one app's price can never be registered under
  // another app, which would let it sell someone else's product.
  stripePriceId String   @unique
  // The tier this price sells at, named by the operator ("starter", "pro",
  // "seat-25"). Deliberately free text: the platform never enumerates tiers,
  // because it does not know what any given app sells. Stamped onto
  // AppTenant.plan when a subscription syncs, which is what finally gives that
  // column a meaning apps can gate features on.
  tier          String
  // The Stripe Product this price belongs to, and its name. One product has
  // many prices (monthly/annual/regional), so the product is what a human
  // recognises in a pricing table while the price id is what gets charged.
  stripeProductId String
  productName     String
  // Cached from Stripe when the price is registered. Safe to cache precisely
  // because Stripe Prices are immutable in these fields - changing an amount
  // or interval means archiving the price and creating a new one - so this
  // copy cannot silently drift from the source of truth.
  unitAmount    Int
  currency      String
  // How often it bills: once | day | week | month | year. 'once' is a
  // one-time purchase, which checks out in Stripe's payment mode rather than
  // subscription mode and has no renewal, grace or cancellation lifecycle.
  // Not an enum: a fixed set would be this schema deciding which billing
  // periods exist, which is Stripe's call and the operator's, not ours.
  interval      String
  intervalCount Int      @default(1)
  // Offered to new customers. Archiving rather than deleting keeps a tier
  // resolvable for everyone already paying for it.
  sellable      Boolean  @default(true)
  // Free trial for this tier, in days. 0 = none.
  trialDays     Int      @default(0)
  // Display order in a pricing table; ties fall back to unitAmount.
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Exactly one price per (tier, billing period), so "check out pro/yearly"
  // resolves to one row rather than an arbitrary pick between duplicates.
  // Multi-currency would extend this key and the selector together.
  @@unique([appId, tier, interval, intervalCount])
  @@index([appId])
  @@map("app_prices")
}

enum AppTenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

// Which tenants may sign in to which apps, and on what terms. No row = the
// app is not enabled for that tenant and logins scoped to it are refused.
model AppTenant {
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appId       String
  app         App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  status      AppTenantStatus @default(ACTIVE)
  plan        String          @default("free")
  // TRIAL logins keep working until this moment.
  trialEndsAt DateTime?
  // While PAST_DUE, logins for this app keep working until this moment.
  graceUntil  DateTime?
  // The Stripe subscription that owns this row's status (one sub per app+tenant).
  stripeSubscriptionId String? @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@id([tenantId, appId])
  @@map("app_tenants")
}

model Role {
  id          String     @id @default(uuid())
  appId       String
  app         App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  name        String
  description String?
  users       UserRole[]

  @@unique([appId, name])
  @@map("roles")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  appClientId String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Operator-editable copy for the mail the platform sends.
//
// There is deliberately NO tenantId column - not even a nullable one meaning
// "platform-level". These templates are platform-wide by design (one voice
// across every product), and a nullable discriminator would be exactly the
// NULL-as-a-kind mistake the schema rules forbid: when there is only one kind,
// the column should not exist.
//
// A missing row is not an error. Every code has a built-in default in
// email-templates.ts, and a row here only overrides it - so recovery mail
// keeps working whether or not anyone has ever opened the editor.
model EmailTemplate {
  // Which message this is: password_reset, email_verify, ...
  code        String   @id
  subject     String
  heading     String
  // One paragraph per line. Admin-authored HTML is trusted here; the
  // {{variables}} substituted into it are escaped, because those carry user
  // input (an address, a workspace name).
  intro       String
  actionLabel String?
  outro       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("email_templates")
}

model SmtpConfig {
  id          String  @id @default(uuid())
  /// null = the platform default config. Postgres treats NULLs as distinct, so
  /// this @unique constrains tenant rows but permits UNLIMITED default rows -
  /// the same NULL-as-a-kind gap User was fixed for. A partial unique index in
  /// 20260821000000_smtp_default_unique closes it; Prisma cannot express one,
  /// so the index lives in the migration and this attribute stays for the
  /// per-tenant case.
  tenantId    String? @unique
  tenant      Tenant? @relation(fields: [tenantId], references: [id])
  host        String
  port        Int
  secure      Boolean @default(false)
  username    String?
  passwordEnc String? // AES-256-GCM encrypted with SECRET_KEY
  fromAddress String

  @@map("smtp_configs")
}

model AuditEvent {
  id          String   @id @default(uuid())
  tenantId    String?
  userId      String?
  appClientId String?
  action      String
  detail      Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}
