# EvoPlatform service configuration
PORT=8200
DATABASE_URL=postgresql://evoplatform:evoplatform@localhost:5433/evoplatform

# Used to encrypt stored SMTP passwords. Set a long random value.
SECRET_KEY=change-me

# RSA signing keypair location (auto-generated on first boot if missing)
KEYS_DIR=./keys

JWT_ISSUER=evoplatform
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Data retention (daily sweep + on boot); 0 keeps audit events forever
RETENTION_AUDIT_DAYS=0
RETENTION_TOKEN_DAYS=30

# Stripe billing (endpoints return 503 until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=7

# Passkeys (WebAuthn). Loopback origins always work for dev; production origins
# must suffix-match a base domain here (one passkey then works on the apex and
# every tenant subdomain), e.g. WEBAUTHN_BASE_DOMAINS=example.com
WEBAUTHN_RP_NAME=EvoPlatform
WEBAUTHN_BASE_DOMAINS=
WEBAUTHN_CHALLENGE_TTL_SEC=300

# Env-level SMTP fallback (used when no config rows exist).
# Defaults target the bundled Mailpit container (docker compose up -d mail);
# inbox UI at http://localhost:8025. Point at a real relay in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@evoplatform.local

# Optional fixed seed passwords (random + printed if unset)
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
