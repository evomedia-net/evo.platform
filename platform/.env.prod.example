# Production configuration for the EvoPlatform service.
# Copy to .env, fill in real values, keep OUT of git (.env is gitignored).
# Used both for docker-compose.prod.yml ${...} interpolation and as the app's env.

# ── Database (compose interpolates DB_USER/PASSWORD/NAME into the db service) ──
DB_USER=evoplatform
DB_PASSWORD=CHANGE-ME-strong-random
DB_NAME=evoplatform
# App connects to the db service by its compose hostname, not localhost:
DATABASE_URL=postgresql://evoplatform:CHANGE-ME-strong-random@db:5432/evoplatform

# ── Crypto (REQUIRED) ─────────────────────────────────────────────────────────
# Encrypts stored SMTP passwords. openssl rand -base64 32
SECRET_KEY=CHANGE-ME-strong-random
JWT_ISSUER=evoplatform
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# ── Passkeys (WebAuthn) ───────────────────────────────────────────────────────
# Set to your real base domain so one passkey works on the apex + tenant subdomains.
WEBAUTHN_RP_NAME=EvoPlatform
WEBAUTHN_BASE_DOMAINS=example.com

# ── Email (real relay in prod) ────────────────────────────────────────────────
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=CHANGE-ME
SMTP_FROM=EvoPlatform <noreply@example.com>

# ── Stripe billing (leave blank to run without billing; endpoints 503) ────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=7

# ── Retention sweeps ──────────────────────────────────────────────────────────
RETENTION_AUDIT_DAYS=0
RETENTION_TOKEN_DAYS=30

# ── Public URL + proxy (REQUIRED behind nginx) ────────────────────────────────
# Used in email links (verify / reset / invite pages).
PUBLIC_BASE_URL=https://platform.example.com
# Rate limiting must see the real client IP through the reverse proxy.
TRUST_PROXY=1

# ── Rate limiting (per IP per minute) ─────────────────────────────────────────
RATE_LIMIT_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=30

# ── First-boot platform admin (replaces the dev seed) ─────────────────────────
# Created only when NO platform admin exists; inert on every later boot, so
# leaving these set is harmless — and lost-admin recovery is: set, restart.
# Password policy (NIST/OWASP Standard): at least 12 characters, no composition
# rules; common passwords and runs like abcde or 12345 are refused. If this fails
# the policy, bootstrap is skipped and the log names the rule that failed.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-2#digits-2#specials

# ── Self-service signup ───────────────────────────────────────────────────────
# closed (default) | invite (admin-issued links) | open
SIGNUP_MODE=closed
SIGNUP_TRIAL_DAYS=14
