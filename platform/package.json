{
  "name": "@evoplatform/platform",
  "version": "0.1.0",
  "private": true,
  "description": "EvoPlatform shared platform service: tenants, users, auth (JWT/JWKS), apps, audit, email",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.m?js$": "<rootDir>/scripts/jest-esm-to-cjs.cjs"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@nestjs/(common|core|platform-express|testing)|file-type|strtok3|token-types|@tokenizer|@borewit|uint8array-extras)/)"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "multer": "^2.4.0",
    "mysql2": "^3.23.1",
    "deepmerge-ts": "^8.0.0",
    "js-yaml": {
      "argparse": "^2.0.1"
    }
  },
  "author": "Kelly Michels <dev@evomedia.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evomedia-net/evo.platform.git",
    "directory": "platform"
  },
  "homepage": "https://evomedia.net"
}
