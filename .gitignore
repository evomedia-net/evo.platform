# Environment / secrets
.env
.env.*
!.env.example
keys/

# Node
node_modules/
.next/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Databases / dumps
*.sqlite
*.sqlite3
*.dump

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log

# Example env files are documentation, not secrets
!.env.prod.example

# vim swap files (a .env swap once nearly leaked into a commit)
*.swp

# Python build artifacts (sdk-python)
build/
*.egg-info/

# Console screenshots under docs/console-*.png are now DOCUMENTATION ASSETS and
# are tracked deliberately. They were ignored while nothing referenced them,
# after being swept in twice by "git add docs" — but the fix for an accidental
# sweep is staging files by name, not ignoring content the docs need.
#
# Scratch captures that are not part of the docs go in the scratchpad, not here.

# Test coverage output
coverage/

# Playwright output (templates/next browser tests)
playwright-report/
test-results/

# Local working notes (plans, diagrams, scratch exports). Anything here that
# should outlive the machine belongs in docs/ under its own name, not in a
# folder git is told to ignore.
md/
